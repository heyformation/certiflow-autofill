# =============================================================================
# Environment variables for the Certification Auto-Fill tool.
# Copy this file to ".env.local" for local dev, and set the same keys in the
# Vercel dashboard (Project > Settings > Environment Variables) for production.
# NEVER commit real secret values.
# =============================================================================

# --- Claude (Anthropic) AI — required for AI document filling ---------------
# Used to fill checkboxes/free-text and generate evaluations.
CLAUDE_API_KEY=""

# --- Neon PostgreSQL — required to persist candidates & generation logs ------
# Get from the Neon dashboard (use the pooled connection string).
DATABASE_URL=""

# --- PDF conversion (optional) ----------------------------------------------
# When set, filled DOCX are also converted to PDF via CloudConvert.
# Leave empty (or set PDF_CONVERSION=off) to deliver DOCX only.
CLOUDCONVERT_API_KEY=""
# PDF_CONVERSION="off"

# --- Google Drive sync (optional) -------------------------------------------
# Only needed if you use the "Envoyer vers Google Drive" feature.
# Paste the private key with literal \n escapes (as one line, in quotes).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# --- App login (optional) ---------------------------------------------------
# If your LoginPage uses an access code, set it here.
# APP_ACCESS_CODE=""
